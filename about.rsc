27:["$","section",null,{"aria-labelledby":"working-heading","className":"profile-section","children":[["$","div",null,{"className":"profile-section__head","children":[["$","p",null,{"className":"eyebrow","children":"Working style"}],["$","h2",null,{"id":"working-heading","children":"How I work with product and engineering"}]]}],["$","ul",null,{"className":"behaviour-list reading-column","children":[["$","li","I write the flows and the information architecture before the screens, and review them with the engineer who will build them.",{"children":"I write the flows and the information architecture before the screens, and review them with the engineer who will build them."}],["$","li","I bring the two options I did not choose to design review, with what each would have cost.",{"children":"I bring the two options I did not choose to design review, with what each would have cost."}],["$","li","I name what I owned, what the team decided together, and what sat outside design scope.",{"children":"I name what I owned, what the team decided together, and what sat outside design scope."}],["$","li","I sit with the people who will use an operations tool before proposing anything for it.",{"children":"I sit with the people who will use an operations tool before proposing anything for it."}],["$","li","I specify edge states — empty, partial, denied, stale, offline — in the same file as the happy path, not in a follow-up ticket.",{"children":"I specify edge states — empty, partial, denied, stale, offline — in the same file as the happy path, not in a follow-up ticket."}],["$","li","I treat handoff as part of the design: decisions written as implementation instructions, not a picture to copy.",{"children":"I treat handoff as part of the design: decisions written as implementation instructions, not a picture to copy."}]]}]]}]
28:["$","section",null,{"aria-labelledby":"ai-heading","className":"profile-section profile-section--note","children":[["$","div",null,{"className":"profile-section__head","children":[["$","p",null,{"className":"eyebrow","children":"AI-assisted development"}],["$","h2",null,{"id":"ai-heading","children":"Where AI sits in the process"}]]}],["$","p",null,{"className":"reading-column","children":"I work with OpenAI Codex and Claude Code, but I stay responsible for the result: I check the states, the layout and the accessibility myself, and I don't show a prototype that hides the difficult cases."}]]}]
