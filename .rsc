20:["$","script",null,{"type":"application/ld+json","children":"{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Person\",\"@id\":\"https://ibazhyn.github.io/#person\",\"name\":\"Oleg Bazhyn\",\"jobTitle\":\"Senior Product Designer\",\"url\":\"https://ibazhyn.github.io/\",\"sameAs\":[\"https://www.linkedin.com/in/oleg-bazhyn-308274113/\"]},{\"@type\":\"ProfilePage\",\"@id\":\"https://ibazhyn.github.io/\",\"url\":\"https://ibazhyn.github.io/\",\"name\":\"UX/UI design for operational products\",\"description\":\"Case studies in operational software, marketplaces and product tools: time tracking, a crypto marketplace, and a fantasy-sports hub.\",\"mainEntity\":{\"@id\":\"https://ibazhyn.github.io/#person\"}}]}"}]
