2e:["$","section",null,{"aria-labelledby":"cases-label","className":"sequence","id":"cases","children":[["$","div",null,{"className":"sequence__head","children":[["$","h2",null,{"className":"sequence__label","id":"cases-label","children":"Cases"}],["$","$L11",null,{"className":"sequence__index","href":"/work","children":"Case index"}]]}],["$","$L30",null,{"demonstrations":false,"items":[{"narrative":{"slug":"productively","title":"Productively","descriptor":"Time and cost tracking","plate":{"id":"productively-time-tracker-active","type":"image","src":"/productively/time-tracker-active.webp","alt":"Productively time tracker: a filterable table of logged entries by project, task and duration, beside a running timer showing two hours fifteen minutes against a project, client, task and subtask, with a billable toggle.","provenance":"production","width":1440,"height":1024,"aspectRatio":"1440 / 1024"},"stages":[{"id":"productively-about","kind":"executive-summary","position":"about","label":"About","headline":"Time, cost and billing in one workspace","description":["Productively is a web app for logging time against projects and clients, seeing what that work costs, and turning the same hours into reports and invoices."],"presentation":{"kind":"none"},"outcome":null},{"id":"productively-brief","kind":"problem-and-stakes","position":"need","label":"Problem","headline":"The product idea existed. The experience didn't","description":["The client brought the concept and the capabilities it wanted. There was no existing product to redesign, so the whole experience, from logging an hour to billing it, was still to be designed."],"presentation":{"kind":"none"},"outcome":null},{"id":"productively-solution","kind":"key-decisions","position":"response","label":"Solution","headline":"Turning the brief into a delivered design","description":["I designed the product from information architecture and key flows through wireframes to the detailed screens. Time is logged three ways, each project shows its own cost, and reports and invoices come from the same logged rows."],"presentation":{"kind":"sequence","states":[{"id":"productively-solution-state-1","label":"Track time","media":{"id":"productively-pillar-track","type":"image","src":"/productively/wall/time-tracker-active-project-based.webp","alt":"Productively time tracker, project-based: a timer at two hours fifteen minutes with project, client, task and subtask chips and a billable switch, a users filter open, and a table of logged entries with duration, billable and status.","provenance":"production","width":1080,"height":768,"aspectRatio":"1080 / 768","caption":"Time Tracker tab: a running timer, the users filter open, and the logged entries below."}},{"id":"productively-solution-state-2","label":"Report and visualize","media":{"id":"productively-pillar-report","type":"image","src":"/productively/wall/reports-analysis.webp","alt":"Productively reports analysis: total, billable and non-billable hours for a period, with a daily chart and grouping by client, project and task.","provenance":"production","width":1080,"height":768,"aspectRatio":"1080 / 768","caption":"Reports analysis: three totals, a bar for each day, and the grouping table."}},{"id":"productively-solution-state-3","label":"Invoice and get paid","media":{"id":"productively-pillar-invoice","type":"image","src":"/productively/wall/receivables-add-invoice-step-1.webp","alt":"Productively Add Invoice dialog, step 1: bill number, dates and service description; a table of projects with approved and unapproved, billable and non-billable hours and total expense; options for all or approved hours, all or billable hours, how to show hours and expenses, and attaching the timelog and expense reports.","provenance":"production","width":1080,"height":768,"aspectRatio":"1080 / 768","caption":"Add Invoice, step 1: each project's hours by approval and billable, and the choice of which hours to bill."}}]},"outcome":null},{"id":"productively-delivered","kind":"outcome","position":"result","label":"Delivered","headline":"A complete experience from tracking to reporting","description":["The delivered design connects time tracking, project cost, approvals, reports and invoicing: the hours logged in one are the hours the others count. I designed it from the brief to the detailed UI."],"presentation":{"kind":"none"},"outcome":{"evidenceType":"Delivered design","statement":"The delivered design connects time tracking, project cost, approvals, reports and invoicing: the hours logged in one are the hours the others count. I designed it from the brief to the detailed UI.","limitation":"This covers the delivered screens only, nothing after the design work."}}]}},{"narrative":{"slug":"nerd-town","title":"Nerd Town","descriptor":"Crypto marketplace","plate":{"id":"nerd-town-main-page","type":"image","src":"/nerd-town/cover.webp","alt":"Nerd Town marketplace: a green Buy Stuff / Sell Stuff hero over an isometric city, four category cards, and a Bitcoin Cash product catalog.","provenance":"production","width":1440,"height":1024,"aspectRatio":"1440 / 1024"},"stages":[{"id":"nerd-town-about","kind":"executive-summary","position":"about","label":"About","headline":"A crypto marketplace for buying and selling","description":["Nerd Town is an online marketplace for collectibles that takes payment in Bitcoin Cash. People browse a catalog, buy or list an item, and move money through an in-app wallet — buying and selling in one place."],"presentation":{"kind":"none"},"outcome":null},{"id":"nerd-town-brief","kind":"problem-and-stakes","position":"need","label":"Problem","headline":"An eBay-like shop. A crypto checkout. No product yet","description":["The client came with an idea for a crypto marketplace — an eBay-like shop for collectibles, with bidding, a catalog and wallets — but no designed product yet. My job was to turn that list into an interface people could use: a cart that completes a purchase, a wallet that makes the currency feel normal, and an escrow that holds the money until the seller approves."],"presentation":{"kind":"none"},"outcome":null},{"id":"nerd-town-solution","kind":"key-decisions","position":"response","label":"Solution","headline":"A shop where a sale can finish, with crypto in the background","description":["I designed the product from the catalog and the listing to the cart to work the way online shops usually do. For the wallet, the hold and the sign-in, neither other shops nor crypto apps had an answer that fit, so each got one of its own."],"presentation":{"kind":"sequence","states":[{"id":"nerd-town-solution-state-1","label":"Buy a collectible","media":{"id":"nerd-town-job-main-page-first-screen","type":"image","src":"/nerd-town/wall/main-page-first-screen.webp","alt":"The first screen of the Nerd Town main page: the logo and the cart, wallet and profile icons in the header, the green Buy Stuff and Sell Stuff doors either side of an isometric city, Explore categories with a card for each category, its photo, its name and its count of items, then the catalog’s first row with Category, Search and the Search button.","caption":"Main page: the two doors, Explore categories and the top of the catalog.","provenance":"production","width":1080,"height":768,"aspectRatio":"1080 / 768"}},{"id":"nerd-town-solution-state-2","label":"Sell a collectible","media":{"id":"nerd-town-job-user-profile-first-screen","type":"image","src":"/nerd-town/wall/user-profile-first-screen.webp","alt":"The first screen of your own page in Nerd Town: your avatar in the header, your card with a photo, the user name, the items listed and sold and the date you joined, List item and Edit profile, About seller and Seller policies, then Category, Search and the filters, Status first.","caption":"Your own page: your card with List item and Edit profile, Seller policies and the filters over your items.","provenance":"production","width":1080,"height":768,"aspectRatio":"1080 / 768"}},{"id":"nerd-town-solution-state-3","label":"Pay and get paid","media":{"id":"nerd-town-job-wallet-first-screen","type":"image","src":"/nerd-town/wall/wallet-first-screen.webp","alt":"The first screen of the Nerd Town wallet: the wallet icon filled in the header, Total, Income and Spending in Bitcoin Cash, Deposit and Withdraw, the Status, Year, Month and Transaction type filters with a search, and the first rows of the history, each with a person, an order, a time, an amount in or out, and its status, a button or a receipt.","caption":"Wallet: the totals, Deposit and Withdraw, the filters and the first rows of the history.","provenance":"production","width":1080,"height":768,"aspectRatio":"1080 / 768"}}]},"outcome":null},{"id":"nerd-town-delivered","kind":"outcome","position":"result","label":"Delivered","headline":"A marketplace you can browse, buy in, and pay from","description":["The delivered design connects the catalog, the listing, the cart, the Bitcoin Cash wallet and seller approval in one experience. I owned the UX and UI across them, from the brief to the detailed screens."],"presentation":{"kind":"none"},"outcome":{"evidenceType":"Delivered design","statement":"The delivered design connects the catalog, the listing, the cart, the Bitcoin Cash wallet and seller approval in one experience. I owned the UX and UI across them, from the brief to the detailed screens.","limitation":"This covers the delivered design for desktop and phone: marketplace, listing, cart, wallet, escrow, seller and account screens."}}]}},{"narrative":{"slug":"wage-fantasy-crypto","title":"Wage Fantasy Crypto","descriptor":"Crypto gaming hub","plate":{"id":"wage-fantasy-crypto-browse-leagues","type":"image","src":"/wage-fantasy-crypto/cover.webp","alt":"Wage Fantasy Crypto: Browse Leagues with a featured Crypto Champions League banner, a top-grossing cryptos panel, and a table of public and private leagues.","provenance":"production","width":1440,"height":1024,"aspectRatio":"1440 / 1024"},"stages":[{"id":"wage-fantasy-crypto-about","kind":"executive-summary","position":"about","label":"About","headline":"Fantasy sports where the roster is cryptocurrency","description":["Wage Fantasy Crypto is a gaming hub where people join or create fantasy leagues, build a team by putting coins in nine weighted positions, follow the weekly results and get paid into an in-app wallet."],"presentation":{"kind":"none"},"outcome":null},{"id":"wage-fantasy-crypto-brief","kind":"problem-and-stakes","position":"need","label":"Problem","headline":"Fantasy sports plus crypto: an idea without a product yet","description":["The client wanted fantasy sports and cryptocurrency in one product, where good strategy could win real money. What did not exist yet was the experience: how to join a league, read its rules and build a team. My job was to design it: league terms anyone can read before joining, a team a newcomer can set up, and a wallet where the winnings arrive."],"presentation":{"kind":"none"},"outcome":null},{"id":"wage-fantasy-crypto-solution","kind":"key-decisions","position":"response","label":"Solution","headline":"Making rules, team creation and the wallet feel like one product","description":["I designed the product from league discovery to team creation, weekly standings and the wallet. It had to feel like a game, not a trading screen: each position holds a coin with a public weight, the league shows its terms before anyone joins, and every join, team change and payout has a clear next step, on desktop and on the phone."],"presentation":{"kind":"sequence","states":[{"id":"wage-fantasy-crypto-solution-state-1","label":"Friends across the hub","media":{"id":"wage-fantasy-crypto-job-friends","type":"image","src":"/wage-fantasy-crypto/wall/friends.webp","alt":"Wage Fantasy Crypto’s Friends page: Friends current in the header beside Browse Leagues, Joined Leagues and Wallet, a search field at the top right, and a table of friends with how many leagues each is playing, their wins and their losses.","caption":"Friends area: the list of friends and the search above it.","provenance":"production","width":1080,"height":768,"aspectRatio":"1080 / 768"}},{"id":"wage-fantasy-crypto-solution-state-2","label":"Multipliers in a match","media":{"id":"wage-fantasy-crypto-job-watch-league-general-division-match-opened-details-opened","type":"image","src":"/wage-fantasy-crypto/wall/watch-league-general-division-match-opened-details-opened.webp","alt":"A week’s match in Wage Fantasy Crypto, open over the league with Detailed Mode on: for each of the two players, marked Winner and Loser, a table of the positions with their coin, increase, multiplier and final value, and a total at the foot.","caption":"A week’s match with Detailed Mode on: each player’s table and its total.","provenance":"production","width":1080,"height":768,"aspectRatio":"1080 / 768"}},{"id":"wage-fantasy-crypto-solution-state-3","label":"The season, week by week","media":{"id":"wage-fantasy-crypto-job-joined-leagues-league-selected","type":"image","src":"/wage-fantasy-crypto/wall/joined-leagues-league-selected.webp","alt":"A league opened from Joined Leagues in Wage Fantasy Crypto: Withdraw Funds & Leave, the league’s terms in a strip, the prize bar, General Division before Playoffs, and the standings with a W, L or D for each player’s week and a clock on the week to come.","caption":"A league opened from Joined Leagues: each week’s marks and a clock on the week to come.","provenance":"production","width":1080,"height":768,"aspectRatio":"1080 / 768"}}]},"outcome":null},{"id":"wage-fantasy-crypto-delivered","kind":"outcome","position":"result","label":"Delivered","headline":"A league you can join, a team you can set, a wallet that pays out","description":["The delivered design takes a player from finding a league to setting a team, following the standings and getting paid into a cryptocurrency wallet, all in one product. I owned its UX and UI, from the brief to the detailed screens."],"presentation":{"kind":"none"},"outcome":{"evidenceType":"Delivered design","statement":"The delivered design takes a player from finding a league to setting a team, following the standings and getting paid into a cryptocurrency wallet, all in one product. I owned its UX and UI, from the brief to the detailed screens.","limitation":"Only the hub, in desktop and phone frames: league discovery, team creation, standings, friends and the wallet. The marketing landing page is not part of this case."}}]}}],"limit":4,"total":3}]]}]
