nner","children":[["$","$L25",null,{"className":"intro__head","children":[["$","h2",null,{"className":"intro__label","id":"profile-label","children":"About me"}],["$","p",null,{"className":"intro__lede","children":"For more than ten years I have designed mobile apps, SaaS products and admin tools. I also code with AI, so I can take a product from the first flow to a working release and keep it running after launch."}]]}],["$","$L25",null,{"className":"intro__body","children":["$","$L26",null,{"faces":["user-flows","ai-coding","product-design","design-systems","product-design","launch-support","ai-coding","launch-support","code-prototypes","user-flows","ai-coding","launch-support","user-flows","code-prototypes","user-flows","code-prototypes","design-systems","product-design","design-systems","product-design"],"skills":[{"mark":"product-design","name":"Product design","use":"Design decisions that balance user needs, business goals and operational constraints.","tools":["Figma","Grok Build"],"turn":2},{"mark":"user-flows","name":"User flows and UI","use":"Information architecture and wireframes first, then high-fidelity screens, checked in usability reviews.","tools":["Figma"],"turn":0},{"mark":"design-systems","name":"Design systems","use":"Scalable Figma components and interface patterns that keep several platforms consistent.","tools":["Figma"],"turn":3},{"mark":"code-prototypes","name":"Prototypes in code","use":"Landing pages, product-site prototypes and admin interface concepts, built in HTML, CSS and JavaScript.","tools":["Claude Code","Vercel"],"turn":8},{"mark":"ai-coding","name":"Coding with AI","use":"Structured prompts, a review of the generated code, and design decisions turned into implementation-ready instructions.","tools":["Claude Code","OpenAI Codex"],"turn":1},{"mark":"launch-support","name":"Launch and support","use":"Hosting, a real database with sign-in, and changes reviewed before they ship.","tools":["GitHub","Railway","Supabase","Cloudflare"],"