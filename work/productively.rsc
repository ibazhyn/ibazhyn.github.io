33:["$","$29","productively-system",{"children":["$","div",null,{"className":"case-band","data-ground":"canvas","children":[["$","$L2a","productively-system",{"children":["$","section",null,{"aria-labelledby":"productively-system-title","className":"case-chapter case-chapter--appendix","id":"productively-system","children":[["$","header",null,{"className":"case-chapter__head","children":[["$","p",null,{"className":"section-label case-chapter__label","children":[["$","span",null,{"aria-hidden":"true","children":"08"}],"System"]}],["$","h2",null,{"id":"productively-system-title","children":"A workspace this wide needs one visual language"}]]}],["$","div",null,{"className":"case-chapter__body","children":[["$","div","productively-system",{"className":"case-chapter__part","children":[null,[["$","div",null,{"className":"case-language__words","children":[["$","div","productively-system-copy-0",{"className":"case-prose","children":[["$","p","Productively has ten areas on the web, and phone apps for logging time, expenses and trips. It only holds together if colour, type and controls are decided once. That is what makes tracking, approvals, reports and invoices feel like one product, not four tools that happen to share a logo.",{"children":"Productively has ten areas on the web, and phone apps for logging time, expenses and trips. It only holds together if colour, type and controls are decided once. That is what makes tracking, approvals, reports and invoices feel like one product, not four tools that happen to share a logo."}],["$","p","The style guide sets a blue primary, a green secondary and Poppins for headings and body. The blue marks navigation, the timer and the current tab, and the screens use it in shades, from the pale fill of a filter chip to the deep blue of the current area. The green marks completed work and positive cost, and each status is a strong colour on a pale fill of the same hue.",{"children":"The style guide sets a blue primary, a green secondary and Poppins for headings and body. The blue marks navigation, the timer and the current tab, and the screens use it in shades, from the pale fill of a filter chip to the deep blue of the current area. The green marks completed work and positive cost, and each status is a strong colour on a pale fill of the same hue."}]]}]]}],["$","div",null,{"className":"case-language","style":{"--language-primary":"#2D6BCF","--language-chip":"#F3F6FC","--language-cross":"#B8CDEF","--language-clock":"#6C97DD","--language-button":"#4F83D7","--language-ink":"#444C5D","--language-current":"#2251B2","--language-tab":"#F8F8F9","--language-track":"#E1E2E5","--language-canvas":"#FFFFFF","--language-rule":"#F9F9F9","--language-edge":"#F1F1F1"},"children":[["$","$L41",null,{"className":"case-language__colours","reachedAt":0.5,"whole":{"where":"(min-width: 64rem)","floor":0.2},"children":[["$","div",null,{"className":"case-language__head","children":[["$","h3",null,{"className":"case-language__label","children":"Colours"}],["$","p",null,{"className":"case-language__hint","children":"Pick a colour on the wheel"}]]}],["$","div",null,{"aria-label":"Productively’s colours","className":"case-language__wheel","role":"radiogroup","style":{"--origin":"217deg"},"children":[["$","span",null,{"aria-hidden":"true","className":"case-language__hues"}],[["$","label","chip",{"className":"case-language__pick","data-ring":"family","style":{"--turn":"352deg","--reach":0.53,"--order":3,"--swatch":"#F3F6FC"},"children":[["$","input",null,{"className":"case-language__chip","defaultChecked":false,"name":"productively-colour","type":"radio","value":"chip"}],["$","span",null,{"className":"case-language__readout","data-tone":"light","children":[["$","span",null,{"className":"case-language__disc","children":[["$","span",null,{"className":"case-language__name","children":"Chip fill"}],["$","span",null,{"className":"case-language__value","children":"#F3F6FC"}],null]}],["$","span",null,{"className":"case-language__use","chi