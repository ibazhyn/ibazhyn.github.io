33:["$","$L2a","nerd-town-brief",{"children":["$","section",null,{"aria-labelledby":"nerd-town-brief-title","className":"case-chapter case-chapter--narrative","id":"nerd-town-brief","children":[["$","header",null,{"className":"case-chapter__head","children":[["$","p",null,{"className":"section-label case-chapter__label","children":[["$","span",null,{"aria-hidden":"true","children":"02"}],"Brief"]}],["$","h2",null,{"id":"nerd-town-brief-title","children":"An eBay-like shop. A crypto checkout. No product yet"}]]}],["$","div",null,{"className":"case-chapter__body","children":[["$","div","nerd-town-brief",{"className":"case-chapter__part","children":[null,[[["$","div","nerd-town-brief-copy-0",{"className":"case-prose","children":[["$","p","The client came with an idea for a crypto marketplace — an eBay-like shop for collectibles, with bidding, a catalog and wallets — but no designed product yet. My job was to turn that list into an interface people could use: a cart that completes a purchase, a wallet that makes the currency feel normal, and an escrow that holds the money until the seller approves.",{"children":"The client came with an idea for a crypto marketplace — an eBay-like shop for collectibles, with bidding, a catalog and wallets — but no designed product yet. My job was to turn that list into an interface people could use: a cart that completes a purchase, a wallet that makes the currency feel normal, and an escrow that holds the money until the seller approves."}],["$","p","Without that interface the list would stay a list: a collector could find an item but not finish buying it, and Bitcoin Cash, not the collectibles, would be the first thing people saw.",{"children":"Without that interface the list would stay a list: a collector could find an item but not finish buying it, and Bitcoin Cash, not the collectibles, would be the first thing people saw."}]]}]],["$","$L52",null,{"className":"case-insight","children":["$","aside",null,{"aria-label":"How I read the 