37:["$","$29","nerd-town-system",{"children":["$","div",null,{"className":"case-band","data-ground":"canvas","children":[["$","$L2a","nerd-town-system",{"children":["$","section",null,{"aria-labelledby":"nerd-town-system-title","className":"case-chapter case-chapter--appendix","id":"nerd-town-system","children":[["$","header",null,{"className":"case-chapter__head","children":[["$","p",null,{"className":"section-label case-chapter__label","children":[["$","span",null,{"aria-hidden":"true","children":"08"}],"System"]}],["$","h2",null,{"id":"nerd-town-system-title","children":"A shop that handles money needs one visual language"}]]}],["$","div",null,{"className":"case-chapter__body","children":[["$","div","nerd-town-system",{"className":"case-chapter__part","children":[null,[["$","div",null,{"className":"case-language__words","children":[["$","div","nerd-town-system-copy-0",{"className":"case-prose","children":[["$","p","Most screens of Nerd Town ask for a decision: open an item or keep browsing, buy or close, approve a sale or wait. Colour, type and controls are decided once, so each choice looks the same wherever it comes up, in the catalog, in a dialog or on a wallet row.",{"children":"Most screens of Nerd Town ask for a decision: open an item or keep browsing, buy or close, approve a sale or wait. Colour, type and controls are decided once, so each choice looks the same wherever it comes up, in the catalog, in a dialog or on a wallet row."}],["$","p","The style guide sets a green primary with a dark ink and a pale mint, and Poppins for headings and body. On the screens the green is the step forward and money coming in, the mint is the choice beside it, and a grey-green sage carries the details. A deep red marks money going out, and orange is kept for the Bitcoin Cash mark beside an amount.",{"children":"The style guide sets a green primary with a dark ink and a pale mint, and Poppins for headings and body. On the screens the green is the step forward and money coming in, the mint is the choice beside it, and a grey-green sage carries the details. A deep red marks money going out, and orange is kept for the Bitcoin Cash mark beside an amount."}]]}]]}],["$","div",null,{"className":"case-language","style":{"--language-primary":"#13C279","--language-ground":"#F3FDF9","--language-mint":"#DFFBEF","--language-sage":"#91A09A","--language-ink":"#2F3039","--language-out":"#C21D13","--language-coin":"#FA8A34","--language-canvas":"#FFFFFF","--language-complain":"#FE3F3F","--language-complain-fill":"#FDF2F2"},"children":[["$","$L52",null,{"className":"case-language__colours","reachedAt":0.5,"whole":{"where":"(min-width: 64rem)","floor":0.2},"children":[["$","div",null,{"className":"case-language__head","children":[["$","h3",null,{"className":"case-language__label","children":"Colours"}],["$","p",null,{"className":"case-language__hint","children":"Pick a colour on the wheel"}]]}],["$","div",null,{"aria-label":"Nerd Town’s colours","className":"case-language__wheel","role":"radiogroup","style":{"--origin":"155deg"},"children":[["$","span",null,{"aria-hidden":"true","className":"case-language__hues"}],[["$","label","ground",{"className":"case-language__pick","data-ring":"family","style":{"--turn":"299deg","--reach":0.53,"--order":2,"--swatch":"#F3FDF9"},"children":[["$","input",null,{"className":"case-language__chip","defaultChecked":false,"name":"nerd-town-colour","type":"radio","value":"ground"}],["$","span",null,{"className":"case-language__readout","data-tone":"light","children":[["$","span",null,{"className":"case-language__disc","children":[["$","span",null,{"className":"case-language__name","children":"Totals ground"}],["$","span",null,{"className":"case-language__value","children":"#F3FDF9"}],null]}],["$","span",null,{"className":"case-language__use","children":"The ground of the wallet’s Total, Income and Spending"}]]}]]}],["$","label","mint",{"className":"case-language__pick","data-ring":"family","style":{"--turn":"371deg","--reach